SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clé service_role (Supabase > Project Settings > API Keys), et NON la clé anon :
# les tables sont sous RLS sans policy, la clé anon lit du vide et n'écrit rien.
# Elle donne un accès total à la base : côté serveur uniquement, jamais commitée.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
GOOGLE_MAPS_API_KEY=AIzaSy...
SESSION_SECRET=change_me_to_a_long_random_string_min_32_chars
NODE_ENV=development
# Affaires à planifier : les ARC des N derniers jours sans stop remontent seuls (défaut 60)
ARC_JOURS_A_PLANIFIER=60
